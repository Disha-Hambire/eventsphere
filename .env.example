# Copy to .env (never commit .env). Used by docker-compose; the same names work as plain env vars.

# --- Database (MySQL) ---
DB_USERNAME=eventsphere
DB_PASSWORD=eventsphere
MYSQL_ROOT_PASSWORD=rootpassword
# Only needed when running the backend outside docker-compose:
# DB_URL=jdbc:mysql://localhost:3306/eventsphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_HOURS=8

# --- AI (optional) --- get a key at https://aistudio.google.com/apikey
# Leave empty to use the built-in rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Password reset e-mail (optional) ---
# Without MAIL_HOST, demo mode shows the 6-digit reset code on screen instead of e-mailing it.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<16-char app password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
PASSWORD_RESET_DEMO_MODE=true

# --- App ---
# Host port for the API container (change if 8080 is already used on your machine)
BACKEND_PORT=8080
# Host port for the MySQL container (only for connecting with a DB tool)
MYSQL_HOST_PORT=3307
SEED_DEMO_DATA=true
APP_TIMEZONE=Asia/Kolkata
